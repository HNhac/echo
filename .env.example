# Copy to `.env` at the repo root. Next.js (web/cms) and the API all read this file.
# After changing NEXT_PUBLIC_* run `npm run build` again.

# --- API ---
HOST=127.0.0.1
PORT=4000
ADMIN_KEY=change-me-strong

# Apex domain — also allows cms.echothuvui.vn / www.echothuvui.vn
PUBLIC_HOST=echothuvui.vn

CORS_ORIGINS=https://echothuvui.vn,https://www.echothuvui.vn,https://cms.echothuvui.vn,http://echothuvui.vn,http://www.echothuvui.vn,http://cms.echothuvui.vn

# Server → API (loopback). Docker Compose: http://api:4000
API_URL=http://127.0.0.1:4000

# Browser → API
NEXT_PUBLIC_API_URL=https://api.echothuvui.vn
