# Copy to `.env` at the repo root. Next.js (web/cms) and the API all read this file.
# After changing NEXT_PUBLIC_* run `npm run build` again.

# --- API ---
HOST=127.0.0.1
PORT=4000
ADMIN_KEY=change-me-strong

# Apex domain — also allows cms.echothuvui.vn / www.echothuvui.vn
PUBLIC_HOST=echothuvui.vn

CORS_ORIGINS=https://echothuvui.vn,https://www.echothuvui.vn,https://cms.echothuvui.vn,http://echothuvui.vn,http://www.echothuvui.vn,http://cms.echothuvui.vn

# Server → API (loopback). Docker Compose: http://api:4000
API_URL=http://127.0.0.1:4000

# Browser → same-origin proxy `/echo-api` (nginx / Next rewrite)
NEXT_PUBLIC_API_URL=/echo-api

# Shop (CMS “xem trên shop”). Local trống thì CMS :3011 → shop :3010
NEXT_PUBLIC_SITE_URL=https://echothuvui.vn

# Đăng nhập Google trên shop (Sign in with Google)
# 1. https://console.cloud.google.com/apis/credentials → Create Credentials → OAuth client ID → Web application
# 2. Authorized JavaScript origins:
#    http://localhost:3010
#    http://127.0.0.1:3010
#    https://echothuvui.vn
#    https://www.echothuvui.vn
# 3. Dán Client ID vào đây, rồi restart API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
